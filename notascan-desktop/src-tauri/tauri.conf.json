{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NotaScan",
  "version": "0.1.0",
  "identifier": "co.edu.notascan.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "NotaScan.", "width": 1440, "height": 900, "minWidth": 1024, "minHeight": 700, "center": true }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "icon": [] }
}
