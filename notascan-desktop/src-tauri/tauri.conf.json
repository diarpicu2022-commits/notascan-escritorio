{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NotaScan",
  "version": "0.1.0",
  "identifier": "co.edu.notascan.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NotaScan.",
        "width": 1280,
        "height": 760,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Calificaciones con IA: la IA detecta, el docente verifica.",
    "publisher": "NotaScan",
    "category": "Education"
  }
}
