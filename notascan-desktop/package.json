{
  "name": "notascan-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "NotaScan. — app de escritorio (Tauri + React + TypeScript + Tailwind + Framer Motion) construida sobre el design system notascan-ui.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo",
    "preview": "vite preview --port 4173",
    "tauri": "tauri",
    "verify:tokens": "node scripts/verify-tokens.mjs",
    "verify:card": "node scripts/verify-card.mjs",
    "verify:shell": "node scripts/verify-shell.mjs",
    "verify:components": "node scripts/verify-components.mjs",
    "verify:teacher": "node scripts/verify-teacher.mjs",
    "verify:admin": "node scripts/verify-admin.mjs",
    "verify:principal": "node scripts/verify-principal.mjs",
    "verify:db": "node scripts/verify-db.mjs",
    "verify:auth": "node scripts/verify-auth.mjs",
    "verify:states": "node scripts/verify-states.mjs",
    "verify:identity": "node scripts/verify-identity.mjs",
    "verify:platform": "node scripts/verify-platform.mjs",
    "verify:platform-auth": "node scripts/verify-platform.mjs auth",
    "verify:invite": "node scripts/verify-invite.mjs",
    "verify:data": "node scripts/verify-data.mjs",
    "verify:teacher-data": "node scripts/verify-teacher-data.mjs",
    "verify:admin-data": "node scripts/verify-admin-data.mjs",
    "verify:principal-data": "node scripts/verify-principal-data.mjs",
    "verify:principal-viewports": "node scripts/verify-principal-viewports.mjs",
    "verify:read-exam": "node scripts/verify-read-exam.mjs",
    "db:seed": "tsx scripts/gen-seed.ts",
    "verify:fields-edge": "node scripts/verify-fields-edge.mjs",
    "verify:desktop-scroll": "node scripts/verify-desktop-scroll.mjs",
    "verify:print": "node scripts/verify-print.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.0",
    "@tauri-apps/api": "^2.12.1",
    "framer-motion": "^11.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "read-excel-file": "^9.3.10",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
